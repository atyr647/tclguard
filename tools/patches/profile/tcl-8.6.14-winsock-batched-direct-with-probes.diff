+/*
+ * TclGuard patch: readyEvents is written by the socket thread (SocketProc) and by the Tcl thread.
+ * Plain |= / &= are read-modify-write and can lose each other's update, so the paths touched by
+ * the patch use interlocked operations.
+ */
+#define TG_ACCEPT_BATCH 16
+#define TG_SET_READY(st, bits)   InterlockedOr((volatile LONG *) &(st)->readyEvents, (LONG) (bits))
+#define TG_CLEAR_READY(st, bits) InterlockedAnd((volatile LONG *) &(st)->readyEvents, ~((LONG) (bits)))
+
 #define SendSelectMessage(tsdPtr, message, payload)     \
     SendMessageW((tsdPtr)->hwnd, SOCKET_SELECT,          \
                 (WPARAM) (message), (LPARAM) (payload))
 
+/* ---- TclGuard PROFILING build only: where does the time of an accepted connection go? Printed every 6 s when TG_SOCKPROF is set. ---- */
+#include <stdio.h>
+enum { P_EVENT, P_LOCK1, P_ACCEPT_OK, P_ACCEPT_EMPTY, P_BATCH, P_TCPACCEPT, P_GNI, P_CREATE, P_CB, P_DSEL, P_CLOSE, P_CLOSESOCK,
+       P_THR_INS, P_THR_REM, P_SOCKPROC, P_FDACCEPT, P_GAP, P_N };
+static const char *pname[P_N] = { "accept event, whole (entry to return)", "waiting for the socket list lock (event entry)", "accept() that took a connection",
+    "accept() that found nothing", "connections per accept event (sum shown as 'ms', read: total / calls)", "TcpAccept (whole)", "getnameinfo",
+    "Tcl_CreateChannel (incl. thread-insert)", "accept callback (the script, incl. close)", "WSAAsyncSelect by the Tcl thread (all calls)",
+    "TcpCloseProc (whole)", "closesocket", "thread action INSERT", "thread action REMOVE", "SocketProc (socket thread, per message)",
+    "FD_ACCEPT notifications received (count only)", "time between two accept events (all of it)" };
+static volatile LONGLONG pv[P_N]; static volatile LONG pn[P_N]; static LONGLONG plast;
+static LONGLONG pnow(void) { LARGE_INTEGER c; QueryPerformanceCounter(&c); return c.QuadPart; }
+#define PSTART LONGLONG pt0 = pnow()
+#define PEND(i) do { InterlockedExchangeAdd64(&pv[i], pnow() - pt0); InterlockedIncrement(&pn[i]); } while (0)
+static void PDump(void) {
+    LARGE_INTEGER f; int i; QueryPerformanceFrequency(&f);
+    fprintf(stderr, "---- socket driver probes\n");
+    for (i = 0; i < P_N; i++) {
+	if (i == P_BATCH) { fprintf(stderr, "%-62s %9ld events, %.2f connections per event\n", pname[i], (long) pn[i], pn[i] ? (double) pv[i] / pn[i] : 0.0); continue; }
+	fprintf(stderr, "%-62s %9ld calls %10.1f ms total %9.1f us each\n", pname[i], (long) pn[i], pv[i] * 1000.0 / f.QuadPart,
+		pn[i] ? pv[i] * 1e6 / f.QuadPart / pn[i] : 0.0);
+    }
+    fflush(stderr);
+}
