+/* ---- TclGuard PROFILING build only: where does the time of an accepted connection go? Printed at exit when TG_SOCKPROF is set. ---- */
+#include <stdio.h>
+enum { P_EV_ACCEPT, P_ACCEPT_CALL, P_ACCEPT_EMPTY, P_TCPACCEPT, P_GNI, P_CREATE, P_SETOPT, P_CB, P_CLOSE, P_CLOSESOCK,
+       P_THR_INS, P_THR_REM, P_SYNC, P_GAP, P_SOCKPROC, P_N };
+static const char *pname[P_N] = { "accept branch of SocketEventProc (to after TcpAccept)", "accept() call", "accept() found nothing",
+    "TcpAccept (whole)", "getnameinfo", "Tcl_CreateChannel (incl. thread-insert)", "two Tcl_SetChannelOption", "accept callback (the script)",
+    "TcpCloseProc (whole)", "closesocket", "thread action INSERT", "thread action REMOVE", "synchronous select/unselect messages",
+    "time between two accept events (all of it)", "SocketProc (socket thread, per message)" };
+static volatile LONGLONG pv[P_N]; static volatile LONG pn[P_N]; static LONGLONG plast;
+static LONGLONG pnow(void) { LARGE_INTEGER c; QueryPerformanceCounter(&c); return c.QuadPart; }
+#define PSTART LONGLONG pt0 = pnow()
+#define PEND(i) do { InterlockedExchangeAdd64(&pv[i], pnow() - pt0); InterlockedIncrement(&pn[i]); } while (0)
+static void PDump(void) {
+    LARGE_INTEGER f; int i; QueryPerformanceFrequency(&f);
+    fprintf(stderr, "---- socket driver probes (QueryPerformanceFrequency %lld)\n", (long long) f.QuadPart);
+    for (i = 0; i < P_N; i++) {
+	fprintf(stderr, "%-58s %9ld calls %10.1f ms total %9.1f us each\n", pname[i], (long) pn[i], pv[i] * 1000.0 / f.QuadPart,
+		pn[i] ? pv[i] * 1e6 / f.QuadPart / pn[i] : 0.0);
+    }
+    fflush(stderr);
+}
