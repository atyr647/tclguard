  * Simple wrapper round the SendMessage syscall.
  */
 
+/*
+ * TclGuard patch: readyEvents is written by the socket thread (SocketProc) and by the Tcl thread.
+ * Plain |= / &= are read-modify-write and can lose each other's update, so the paths touched by
+ * the patch use interlocked operations.
+ */
+#define TG_SET_READY(st, bits)   InterlockedOr((volatile LONG *) &(st)->readyEvents, (LONG) (bits))
+#define TG_CLEAR_READY(st, bits) InterlockedAnd((volatile LONG *) &(st)->readyEvents, ~((LONG) (bits)))
+
 #define SendSelectMessage(tsdPtr, message, payload)     \
     SendMessageW((tsdPtr)->hwnd, SOCKET_SELECT,          \
                 (WPARAM) (message), (LPARAM) (payload))
 
+/*
+ * TclGuard patch: the same registration the socket thread performs for a SOCKET_SELECT message (see SocketProc), done by the
+ * calling thread itself. WSAAsyncSelect() may be called from any thread for a window owned by another one, so the synchronous
+ * SendMessage round trip to the socket thread (two thread switches, hundreds of microseconds on a busy or virtualised machine)
+ * is not needed where only the registration matters: creating and closing a channel, accepting and connecting. It is NOT used
+ * where the original relies on the socket thread having finished with the socket before a read or select() (the blocking paths).
+ */
+static void
+TgDirectSelect(
+    ThreadSpecificData *tsdPtr,
+    int message,
+    TcpState *statePtr)
+{
+    TcpFdList *fds;
+
+    for (fds = statePtr->sockets; fds != NULL; fds = fds->next) {
+	if (message == SELECT) {
+	    WSAAsyncSelect(fds->fd, tsdPtr->hwnd, SOCKET_MESSAGE, statePtr->selectEvents);
+	} else {
+	    WSAAsyncSelect(fds->fd, tsdPtr->hwnd, 0, 0);
+	}
+    }
+}
