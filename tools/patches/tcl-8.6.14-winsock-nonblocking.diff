  * Simple wrapper round the SendMessage syscall.
  */
 
+/*
+ * TclGuard patch: readyEvents is written by the socket thread (SocketProc) and by the Tcl thread.
+ * Plain |= / &= are read-modify-write and can lose each other's update, so the paths touched by
+ * the patch use interlocked operations.
+ */
+#define TG_ACCEPT_BATCH 16
+#define TG_SET_READY(st, bits)   InterlockedOr((volatile LONG *) &(st)->readyEvents, (LONG) (bits))
+#define TG_CLEAR_READY(st, bits) InterlockedAnd((volatile LONG *) &(st)->readyEvents, ~((LONG) (bits)))
+
 #define SendSelectMessage(tsdPtr, message, payload)     \
     SendMessageW((tsdPtr)->hwnd, SOCKET_SELECT,          \
                 (WPARAM) (message), (LPARAM) (payload))
 
+/*
+ * TclGuard patch: the same registration the socket thread performs for a SOCKET_SELECT message (see SocketProc), done by the
+ * calling thread itself. WSAAsyncSelect() may be called from any thread for a window owned by another one. The synchronous
+ * SendMessage round trip to the socket thread (about 100 microseconds each, three per connection) is what, together with accepting
+ * one connection per notification, made the accept rate collapse under a connection flood: with both removed a raw accept loop
+ * holds 9,000+ connections per second, with only the messages left it fell to a few hundred and then to nothing (measured with
+ * tests/load/winsock_cost.c on a Windows runner, docs/WINDOWS-ACCEPT.md). It is used only where just the registration matters:
+ * creating and closing a channel, accepting and connecting. It is NOT used where the original relies on the socket thread having
+ * finished with the socket before a read or select() (the blocking paths).
+ */
+static void
+TgDirectSelect(
+    ThreadSpecificData *tsdPtr,
+    int message,
+    TcpState *statePtr)
+{
+    TcpFdList *fds;
+
+    for (fds = statePtr->sockets; fds != NULL; fds = fds->next) {
+	if (message == SELECT) {
+	    WSAAsyncSelect(fds->fd, tsdPtr->hwnd, SOCKET_MESSAGE, statePtr->selectEvents);
+	} else {
+	    WSAAsyncSelect(fds->fd, tsdPtr->hwnd, 0, 0);
+	}
+    }
+}
